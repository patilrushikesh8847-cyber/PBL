INTERVIEW_COACH_DB=./data/interview_coach.db
APP_ENV=development
# Select Anthropic to enable server-side question generation and evaluation.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-with-your-server-side-key
ANTHROPIC_MODEL=replace-with-an-enabled-model-id
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
